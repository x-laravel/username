{
    "name": "x-laravel/username",
    "description": "Configurable username validation, reserved-name checking and username generation for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "username", "validation", "reserved", "slug"],
    "authors": [
        {
            "name": "Mehmet ÖĞMEN",
            "email": "www@mehmetogmen.com.tr",
            "homepage": "https://www.mehmetogmen.com.tr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "XLaravel\\Username\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XLaravel\\Username\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "XLaravel\\Username\\UsernameServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "test": "phpunit"
    }
}
